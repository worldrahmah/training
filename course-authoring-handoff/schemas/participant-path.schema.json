{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://training-engine.local/schema/participant-path.schema.json",
  "title": "Training Engine Participant Path v2.0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "title",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string"
    },
    "objective_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body_md": {
            "type": "string"
          },
          "content": {
            "type": "object",
            "properties": {
              "blocks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "hero",
                        "text",
                        "image",
                        "image_text",
                        "cards",
                        "steps",
                        "comparison",
                        "table",
                        "timeline",
                        "callout",
                        "statistic",
                        "quote",
                        "checklist",
                        "asset",
                        "chart",
                        "video",
                        "audio",
                        "divider",
                        "spacer",
                        "gallery",
                        "prompt",
                        "editable_prompt",
                        "resource_list",
                        "leaderboard",
                        "document",
                        "slide_deck",
                        "formula",
                        "interactive_video"
                      ]
                    },
                    "id": {
                      "type": "string"
                    },
                    "helper_text": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "completion": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "acknowledge",
                  "text",
                  "url",
                  "file",
                  "image",
                  "checklist",
                  "external",
                  "none"
                ]
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "optional": {
            "type": "boolean"
          },
          "use_template": {
            "type": "string"
          },
          "overrides": {
            "type": "object"
          },
          "interaction": {
            "type": "object",
            "required": [
              "activity_id"
            ],
            "additionalProperties": false,
            "properties": {
              "activity_id": {
                "type": "string"
              }
            }
          },
          "interactions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "activity_id"
              ],
              "additionalProperties": false,
              "properties": {
                "activity_id": {
                  "type": "string"
                }
              }
            }
          },
          "when": {
            "type": "object",
            "properties": {
              "path_id": {
                "type": "string"
              },
              "activity_id": {
                "type": "string"
              },
              "equals": {},
              "lt": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "score": {
      "type": "object"
    },
    "achievement": {
      "type": "object"
    },
    "internet_required": {
      "type": "boolean"
    },
    "offline_fallback": {
      "type": "object"
    },
    "guided": {
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    }
  }
}
