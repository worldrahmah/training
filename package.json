{
  "name": "training-engine-one",
  "version": "3.5.0-rc.1.17",
  "private": true,
  "type": "module",
  "description": "Training Engine ONE — local-first professional training management, course authoring and live classroom platform",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "prestart": "node tools/cache-google-fonts.mjs --optional",
