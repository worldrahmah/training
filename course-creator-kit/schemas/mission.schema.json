{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://training-engine.local/schema/mission.schema.json",
  "title": "Training Engine Mission v2.0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "title",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string"
    },
    "estimated_minutes": {
      "type": "number",
      "minimum": 0
    },
    "objective_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title"
        ]
      }
    },
    "prompts": {
      "type": "array"
    },
    "assets": {
      "type": "array"
    },
    "external_tools": {
      "type": "array"
    },
    "submission": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "none",
            "text",
            "url",
            "file",
            "image"
          ]
        },
        "prompt": {
          "type": "string"
        }
      }
    },
    "score": {
      "type": "object"
    },
    "achievement": {
      "type": "object"
    }
  }
}
