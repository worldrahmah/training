{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://training-engine.local/schema/module.schema.json",
  "title": "Training Engine Module v2.0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "title"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "number",
      "minimum": 0
    },
    "objective_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "$ref": "activity.schema.json"
      }
    },
    "missions": {
      "type": "array",
      "items": {
        "$ref": "mission.schema.json"
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "$ref": "participant-path.schema.json"
      }
    },
    "workflow": {
      "$ref": "workflow.schema.json"
    },
    "step_templates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body_md": {
            "type": "string"
          },
          "content": {
            "type": "object",
            "properties": {
              "blocks": {
                "type": "array",
                "items": {
                  "$ref": "./content-block.schema.json"
                }
              }
            }
          },
          "completion": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "acknowledge",
                  "text",
                  "url",
                  "file",
                  "image",
                  "checklist",
                  "external",
                  "none"
                ]
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "optional": {
            "type": "boolean"
          },
          "use_template": {
            "type": "string"
          },
          "overrides": {
            "type": "object"
          },
          "interaction": {
            "type": "object",
            "required": [
              "activity_id"
            ],
            "additionalProperties": false,
            "properties": {
              "activity_id": {
                "type": "string"
              }
            }
          },
          "interactions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "activity_id"
              ],
              "additionalProperties": false,
              "properties": {
                "activity_id": {
                  "type": "string"
                }
              }
            }
          },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "path_id"
                ],
                "properties": {
                  "path_id": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              {
                "required": [
                  "activity_id",
                  "equals"
                ],
                "properties": {
                  "activity_id": {
                    "type": "string"
                  },
                  "equals": {}
                },
                "additionalProperties": false
              },
              {
                "required": [
                  "activity_id",
                  "lt"
                ],
                "properties": {
                  "activity_id": {
                    "type": "string"
                  },
                  "lt": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            ],
            "properties": {
              "path_id": {
                "type": "string"
              },
              "activity_id": {
                "type": "string"
              },
              "equals": {},
              "lt": {
                "type": "number"
              }
            }
          },
          "layout": {
            "enum": [
              "standard",
              "focused",
              "compact",
              "wide",
              "centered",
              "instruction",
              "prompt_task",
              "choice",
              "assessment",
              "reflection"
            ]
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    }
  }
}
