{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://training-engine.local/schema/participant-path.schema.json",
  "title": "Training Engine Participant Path v2.0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "title",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string"
    },
    "objective_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body_md": {
            "type": "string"
          },
          "content": {
            "type": "object",
            "properties": {
              "blocks": {
                "type": "array",
                "items": {
                  "$ref": "./content-block.schema.json"
                }
              }
            }
          },
          "completion": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "acknowledge",
                  "text",
                  "url",
                  "file",
                  "image",
                  "checklist",
                  "external",
                  "none"
                ]
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "optional": {
            "type": "boolean"
          },
          "use_template": {
            "type": "string"
          },
          "overrides": {
            "type": "object"
          },
          "interaction": {
            "type": "object",
            "required": [
              "activity_id"
            ],
            "additionalProperties": false,
            "properties": {
              "activity_id": {
                "type": "string"
              }
            }
          },
          "interactions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "activity_id"
              ],
              "additionalProperties": false,
              "properties": {
                "activity_id": {
                  "type": "string"
                }
              }
            }
          },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "path_id"
                ],
                "properties": {
                  "path_id": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              {
                "required": [
                  "activity_id",
                  "equals"
                ],
                "properties": {
                  "activity_id": {
                    "type": "string"
                  },
                  "equals": {}
                },
                "additionalProperties": false
              },
              {
                "required": [
                  "activity_id",
                  "lt"
                ],
                "properties": {
                  "activity_id": {
                    "type": "string"
                  },
                  "lt": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            ],
            "properties": {
              "path_id": {
                "type": "string"
              },
              "activity_id": {
                "type": "string"
              },
              "equals": {},
              "lt": {
                "type": "number"
              }
            }
          },
          "layout": {
            "enum": [
              "standard",
              "focused",
              "compact",
              "wide",
              "centered",
              "instruction",
              "prompt_task",
              "choice",
              "assessment",
              "reflection"
            ]
          }
        },
        "anyOf": [
          {
            "required": [
              "title"
            ]
          },
          {
            "required": [
              "id",
              "use_template"
            ]
          }
        ]
      }
    },
    "score": {
      "type": "object"
    },
    "achievement": {
      "type": "object"
    },
    "internet_required": {
      "type": "boolean"
    },
    "offline_fallback": {
      "type": [
        "string",
        "object"
      ]
    },
    "guided": {
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "eyebrow": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "metadata": {
      "type": "string"
    },
    "image_asset": {
      "type": "string"
    }
  }
}
